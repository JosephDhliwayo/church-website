# Public URL of this site (used for payment redirect/callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres database (e.g. Neon or Vercel Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Pesepay Zimbabwe — https://pesepay.com (Merchant dashboard > Integrations)
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=

# Stripe — https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
